# Copy to .env (gitignored) before running docker compose.
# Never commit real secrets — .env, *.pem, application-local.* are all gitignored.

POSTGRES_USER=bankapp
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=bankapp
POSTGRES_PORT=5432

REDIS_PORT=6379
KAFKA_PORT=9092

# Generate with the openssl command in docs/28 §1c. No default — the app will not start without it.
BANKAPP_JWT_PRIVATE_KEY=
